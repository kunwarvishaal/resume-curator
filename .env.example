# Server-side OpenAI key (never expose to the browser)
OPENAI_API_KEY=sk-your-key-here

# Optional — defaults to gpt-4.1 if unset
OPENAI_MODEL=gpt-4.1

# Gates the whole app behind a shared password. REQUIRED in production: without it
# a production build refuses to serve (HTTP 503) unless ALLOW_OPEN_ACCESS=true.
# Leave unset for open access during local development (npm run dev).
APP_PASSWORD=choose-a-strong-passphrase

# Optional — extra key for signing session cookies. Change it to sign everyone out
# without changing APP_PASSWORD (changing APP_PASSWORD also signs everyone out).
# SESSION_SECRET=

# Optional — set to true ONLY if you deliberately want a public deployment with no login.
# ALLOW_OPEN_ACCESS=true
