# Server-side OpenAI key (never expose to the browser)
OPENAI_API_KEY=sk-your-key-here

# Optional — defaults to gpt-4.1 if unset
OPENAI_MODEL=gpt-4.1

# Gates the whole app behind a shared password (recommended once deployed publicly).
# Leave unset for open access during local development.
APP_PASSWORD=choose-a-strong-passphrase
